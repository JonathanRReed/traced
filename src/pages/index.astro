---
import BaseLayout from '../layouts/BaseLayout.astro'
import Footer from '../components/Footer.astro'
import { getAllBreaches } from '../lib/hibp'
import { byNewest, formatPwnCount, getAllDataClasses, getTotalPwnCount, yearStats } from '../lib/utils'
import { isIndexableCase } from '../lib/index-policy'
import { Ledger } from '../components/Ledger'
import type { BreachSummary } from '../lib/types'

const PAGE_SIZE = 60

const breaches = await getAllBreaches()
const totalPwned = getTotalPwnCount(breaches)
const dataClasses = getAllDataClasses(breaches)
const years = yearStats(breaches)
const passwordCount = breaches.filter((b) => b.DataClasses.includes('Passwords')).length
const fullRecordCount = breaches.filter(isIndexableCase).length

// Every number on this page is counted from the same HIBP payload the pages
// are built from, so the copy cannot drift from the list it describes.
const count = breaches.length.toLocaleString('en-US')

// The headline is three lines, each sized to fill the width of the page.
const headline = [formatPwnCount(totalPwned), 'accounts exposed in', `${count} breaches`]

// Only the fields the list reads, and only the first screenful: the rest
// arrives from /breaches.json once the browser is idle.
const initial: BreachSummary[] = [...breaches]
  .sort(byNewest)
  .slice(0, PAGE_SIZE)
  .map((b) => ({
    Name: b.Name,
    Title: b.Title,
    Domain: b.Domain,
    BreachDate: b.BreachDate,
    AddedDate: b.AddedDate,
    PwnCount: b.PwnCount,
    DataClasses: b.DataClasses,
    LogoPath: b.LogoPath,
  }))
---

<BaseLayout
  currentPath="/"
  title="TRACED | Data Breach Archive and Password Checker"
  description="Search public data breaches from Have I Been Pwned, read case files for each leak, and check if a password has been exposed without sending it off your device."
>
  <main id="main-content" tabindex="-1">
    <header class="hero band">
      <div class="wrap">
        <h1 class="lockup">
          {headline.map((line) => (
            <span style={`--chars: ${line.length}`}>{line} </span>
          ))}
        </h1>
      </div>
    </header>

    <Ledger client:load initial={initial} total={breaches.length} years={years} dataClasses={dataClasses} />

    <noscript>
      <p class="wrap colophon">
        Search and filters need JavaScript. You can still browse all {fullRecordCount} full breach records in{' '}
        <a href="/archive/">the case index</a>, starting with the newest.
      </p>
    </noscript>

    <hr class="divider" />

    <!-- Plain-language note about the site. Placed below the list so visitors
         can jump straight into searching. -->
    <div class="wrap colophon">
      <p>
        TRACED is a searchable archive of public data breaches, pulled from
        <a href="https://haveibeenpwned.com" target="_blank" rel="noopener">Have I Been Pwned<span class="sr-only"> (opens in a new tab)</span></a>
        whenever the site rebuilds. Each of the {count} breaches has its own case file showing when it happened, what
        kind of data leaked, and when HIBP added it. Out of those, {passwordCount.toLocaleString('en-US')} included
        passwords.
      </p>
      <p>
        Look up a site or app you've had an account on. If it shows up here, change your password there and anywhere
        else you reused it. You can also <a href="/check/">check a password directly</a> against known leaks without it
        ever leaving your browser.
      </p>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(1.25rem, 3.5vw, 2.5rem);
  }

  /* The face is fixed-pitch, so the size that makes a line span the page
     follows from how many characters it has. */
  .lockup {
    container-type: inline-size;
    display: grid;
    line-height: 0.9;
  }

  .lockup span {
    font-size: calc(100cqw / (var(--chars) * 0.612));
    white-space: nowrap;
  }

  /* The other faces in the Aa menu are not fixed-pitch, so they set the
     headline as an ordinary large sentence instead. */
  :global(html[data-font]) .lockup {
    display: block;
    font-size: clamp(2rem, 7vw, 5rem);
    line-height: 1.1;
  }

  :global(html[data-font]) .lockup span {
    font-size: inherit;
    white-space: normal;
  }

  .colophon {
    display: grid;
    gap: 1rem 4rem;
    padding-block: clamp(2rem, 5vw, 3rem) clamp(3rem, 7vw, 5rem);
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  @media (min-width: 56rem) {
    .colophon {
      grid-template-columns: repeat(2, minmax(0, 30rem));
    }
  }
</style>
