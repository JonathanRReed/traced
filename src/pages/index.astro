---
import BaseLayout from '../layouts/BaseLayout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { HeroTitle } from '../components/HeroTitle'
import { getAllBreaches } from '../lib/hibp'
import { getTotalPwnCount, getAllDataClasses, getBreachStatus } from '../lib/utils'
import { TimelineScrubber } from '../components/TimelineScrubber'
import { BreachArchive } from '../components/BreachArchive'
import FieldBriefing from '../components/FieldBriefing.astro'

const breaches = await getAllBreaches()
const totalPwned = getTotalPwnCount(breaches)
const totalDataClasses = getAllDataClasses(breaches).length
const criticalCount = breaches.filter((b) => getBreachStatus(b) === 'CRITICAL').length

function formatBigNumber(n: number): string {
  if (n >= 1_000_000_000) return (n / 1_000_000_000).toFixed(1) + 'B'
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(0) + 'M'
  return n.toLocaleString()
}
---

<BaseLayout
  title="TRACED | Data Breach Archive and Password Checker"
  description="Browse public breach case files, compare exposed account records, and check passwords against Have I Been Pwned sources without sending the full password."
>
  <Nav currentPath="/" />

  <main id="main-content" tabindex="-1">
    <section class="hero">
      <header class="hero-inner">
        <div class="hero-eyebrow">Public Breach Archive</div>
        <h1 class="hero-title">
          <span class="sr-only">TRACED: public data breach archive and password exposure checker</span>
          <span aria-hidden="true"><HeroTitle client:load /></span>
        </h1>
        <p class="hero-tagline">KNOWN BREACHES. ON THE RECORD.</p>

        <dl class="hero-stats" aria-label="Breach archive summary">
          <div class="stat">
            <dt class="stat-label">CASE FILES</dt>
            <dd class="stat-value" data-count={breaches.length}>{breaches.length}</dd>
          </div>
          <div class="stat-divider">·</div>
          <div class="stat">
            <dt class="stat-label">EXPOSED ACCOUNTS</dt>
            <dd class="stat-value" data-count={totalPwned} data-count-format="big">{formatBigNumber(totalPwned)}</dd>
          </div>
          <div class="stat-divider">·</div>
          <div class="stat">
            <dt class="stat-label">DATA TYPES EXPOSED</dt>
            <dd class="stat-value" data-count={totalDataClasses}>{totalDataClasses}</dd>
          </div>
          <div class="stat-divider">·</div>
          <div class="stat">
            <dt class="stat-label">CRITICAL</dt>
            <dd class="stat-value critical-val" data-count={criticalCount}>{criticalCount}</dd>
          </div>
        </dl>

        <nav class="hero-cta-row" aria-label="Primary breach archive actions">
          <a href="#archive" class="hero-cta">BROWSE THE ARCHIVE ↓</a>
          <a href="/check/" class="hero-cta hero-cta-ghost">CHECK A PASSWORD →</a>
        </nav>

        <p class="hero-note">
          TRACED reads the public Have I Been Pwned breach records and lays each one out as a case file. Every page shows
          the breach date, what data got out, and how bad it was, so you can work out which of your accounts actually
          need a new password or a passkey. No accounts, no analytics, and no password ever reaches a server here.
        </p>
      </header>

      <div class="hero-grid-bg" aria-hidden="true">
      </div>

      <div class="hero-glow" aria-hidden="true"></div>
    </section>

    <FieldBriefing breachCount={breaches.length} criticalCount={criticalCount} />

    <TimelineScrubber client:only="react" />

    <section id="archive" aria-labelledby="archive-heading">
      <h2 id="archive-heading" class="sr-only">Breach Archive</h2>
      <p class="archive-index-line">
        The grid below needs JavaScript to search and filter. If you just want the list,
        <a href="/archive/">the case index</a> has every file in date order.
      </p>
      <BreachArchive client:only="react" />
    </section>
  </main>

  <Footer />
</BaseLayout>

<script type="module" src="/count-up.js"></script>

<style>
  main {
    min-height: 100vh;
  }

  .hero {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 2rem 4rem;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.35em;
    color: var(--color-accent);
    opacity: 0.8;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(5rem, 18vw, 14rem);
    letter-spacing: 0.12em;
    color: var(--color-text);
    margin: 0;
    line-height: 0.9;
    text-shadow: 0 0 80px rgba(59, 130, 246, 0.15);
    animation: fade-up 0.8s ease both;
  }

  .hero-tagline {
    font-family: var(--font-mono);
    font-size: clamp(0.55rem, 1.5vw, 0.75rem);
    letter-spacing: 0.35em;
    color: var(--color-muted);
    margin: 0;
    animation: fade-up 0.8s ease 0.3s both;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
    animation: fade-up 0.8s ease 0.6s both;
    padding: 1rem 2rem;
    border: 1px solid var(--color-border);
    background: rgba(13, 17, 23, 0.6);
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .stat-value {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.6rem;
    color: var(--color-text);
    letter-spacing: 0.05em;
    line-height: 1;
    margin: 0;
  }

  .critical-val { color: var(--color-danger); }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: var(--color-muted);
  }

  .stat-divider {
    font-family: var(--font-mono);
    color: var(--color-border);
    font-size: 1.2rem;
  }

  .hero-cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    animation: fade-up 0.8s ease 0.9s both;
  }

  .hero-cta {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    font-weight: 600;
    text-decoration: none;
    padding: 10px 24px;
    border: 1px solid var(--color-accent-hover);
    color: #fff;
    background: var(--color-accent-hover);
    transition: all 0.15s;
    border-radius: 2px;
  }

  .hero-cta:hover { background: var(--color-accent-press); border-color: var(--color-accent-press); }

  .hero-cta-ghost {
    background: transparent;
    color: var(--color-muted);
    border-color: var(--color-border);
  }

  .hero-cta-ghost:hover { color: var(--color-text); border-color: var(--color-muted); background: transparent; }

  .hero-note {
    max-width: 640px;
    margin: 1.25rem auto 0;
    color: var(--color-muted);
    line-height: 1.7;
    font-size: 0.95rem;
    animation: fade-up 0.8s ease 1s both;
  }

  .archive-index-line {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.5rem 2rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.8;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .archive-index-line a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
  }

  .archive-index-line a:hover { border-bottom-color: var(--color-accent); }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    pointer-events: none;
    z-index: 0;
    background-image:
      linear-gradient(var(--color-text) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-text) 1px, transparent 1px);
    background-size: 10% 12.5%;
    animation: grid-pulse 4s ease-in-out infinite;
  }

  @keyframes grid-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.3; }
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(59, 130, 246, 0.08) 0%, transparent 70%);
  }

  @media (max-width: 640px) {
    .hero { padding: 4rem 1rem 3rem; }
    .hero-stats { gap: 1rem; padding: 0.75rem 1rem; }
    .stat-divider { display: none; }
    .archive-index-line { padding: 1.25rem 1rem 0.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-grid-bg { animation: none; }
  }
</style>
