---
import type { GetStaticPaths, Page } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import { getAllBreaches } from '../../lib/hibp'
import {
  ARCHIVE_PAGE_SIZE,
  archiveCases,
  archivePageCount,
  archivePagePath,
} from '../../lib/archive-index'
import {
  formatBreachDate,
  formatPwnCount,
  getBreachStatus,
  slugify,
} from '../../lib/utils'
import { StatusBadge } from '../../components/StatusBadge'
import type { HibpBreach } from '../../lib/types'

export const getStaticPaths = (async ({ paginate }) => {
  const breaches = await getAllBreaches()
  return paginate(archiveCases(breaches), { pageSize: ARCHIVE_PAGE_SIZE })
}) satisfies GetStaticPaths

interface Props {
  page: Page<HibpBreach>
}

const { page } = Astro.props

const current = page.currentPage
const lastPage = archivePageCount(page.total)
const pageNumbers = Array.from({ length: lastPage }, (_, i) => i + 1)
const firstIndex = page.start + 1
const lastIndex = page.end + 1

function monthYear(dateStr: string): string {
  const date = new Date(dateStr)
  if (Number.isNaN(date.getTime())) return 'an undated incident'
  return date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
}

const newestOnPage = monthYear(page.data[0]?.BreachDate ?? '')
const oldestOnPage = monthYear(page.data[page.data.length - 1]?.BreachDate ?? '')
const span =
  newestOnPage === oldestOnPage
    ? `dated ${newestOnPage}`
    : `from ${newestOnPage} back to ${oldestOnPage}`

const pageTitle = `Breach Case Archive: Page ${current} | TRACED`
const pageDescription = `Page ${current} of the TRACED breach case index: ${page.data.length} case files ${span}, each listed with its breach date and the number of accounts exposed.`

const siteUrl = 'https://traced.jonathanrreed.com'
const canonicalPath = archivePagePath(current)
const canonicalUrl = `${siteUrl}${canonicalPath}`

const archiveSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: `Breach case archive, page ${current} of ${lastPage}`,
      description: pageDescription,
      url: canonicalUrl,
      isPartOf: { '@type': 'WebSite', name: 'TRACED', url: siteUrl },
      isAccessibleForFree: true,
      mainEntity: {
        '@type': 'ItemList',
        name: 'Breach case files',
        numberOfItems: page.data.length,
        itemListOrder: 'https://schema.org/ItemListOrderDescending',
        itemListElement: page.data.map((breach, i) => ({
          '@type': 'ListItem',
          position: page.start + i + 1,
          name: `${breach.Title} data breach`,
          url: `${siteUrl}/case/${slugify(breach.Name)}/`,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Archive', item: `${siteUrl}/` },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Case index',
          item: `${siteUrl}/archive/`,
        },
        ...(current > 1
          ? [
              {
                '@type': 'ListItem',
                position: 3,
                name: `Page ${current}`,
                item: canonicalUrl,
              },
            ]
          : []),
      ],
    },
  ],
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  robots="index,follow"
  extraSchema={archiveSchema}
>
  <Nav currentPath="/archive/" />

  <main id="main-content" tabindex="-1" class="index-page">
    <div class="wrap index-container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Archive</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Case index</span>
      </nav>

      <header class="index-header">
        <h1>Breach case archive</h1>
        <p class="muted data">
          Page {current} of {lastPage}, cases {firstIndex} to {lastIndex} of {page.total}
        </p>
        <p>
          Every case file in the archive, newest breach first. {page.total} of them, {ARCHIVE_PAGE_SIZE} to a page.
        </p>
      </header>

      <table class="index-table">
        <caption class="sr-only">Breach case files {firstIndex} to {lastIndex}</caption>
        <thead>
          <tr>
            <th scope="col">No.</th>
            <th scope="col">Case</th>
            <th scope="col">Status</th>
            <th scope="col">Breach date</th>
            <th scope="col" class="num">Accounts</th>
          </tr>
        </thead>
        <tbody>
          {page.data.map((breach, i) => (
            <tr>
              <td class="data muted" data-label="No.">{String(page.start + i + 1).padStart(3, '0')}</td>
              <td class="cell-case">
                <a href={`/case/${slugify(breach.Name)}/`}>{breach.Title}</a>
                {breach.Domain && <span class="data muted">{breach.Domain}</span>}
              </td>
              <td data-label="Status"><StatusBadge status={getBreachStatus(breach)} /></td>
              <td class="data" data-label="Breach date">{formatBreachDate(breach.BreachDate)}</td>
              <td class="data num" data-label="Accounts">{formatPwnCount(breach.PwnCount)}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <nav class="pager" aria-label="Case index pages">
        {page.url.prev ? (
          <a href={archivePagePath(current - 1)} rel="prev" class="btn btn-ghost">Previous</a>
        ) : (
          <span class="btn btn-ghost is-off" aria-disabled="true">Previous</span>
        )}

        <ol class="pager-nums">
          {pageNumbers.map((n) =>
            n === current ? (
              <li><span class="pager-num is-current" aria-current="page">{n}</span></li>
            ) : (
              <li><a class="pager-num" href={archivePagePath(n)}>{n}</a></li>
            ),
          )}
        </ol>

        {page.url.next ? (
          <a href={archivePagePath(current + 1)} rel="next" class="btn btn-ghost">Next</a>
        ) : (
          <span class="btn btn-ghost is-off" aria-disabled="true">Next</span>
        )}
      </nav>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .index-page {
    min-height: 100vh;
    padding-bottom: 5rem;
  }

  .index-container {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
  }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }

  .breadcrumb a {
    color: var(--signal);
  }

  .index-header {
    display: grid;
    gap: 0.6rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .index-header h1 {
    font-size: clamp(2.5rem, 7vw, 4rem);
  }

  .index-table {
    width: 100%;
    border-collapse: collapse;
  }

  .index-table th {
    padding: 0.6rem 0.75rem;
    text-align: left;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--muted-foreground);
    border-bottom: 1px solid var(--border);
  }

  .index-table td {
    padding: 0.8rem 0.75rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }

  .index-table tbody tr:hover {
    background: var(--card);
  }

  .num {
    text-align: right;
  }

  .cell-case {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .cell-case a {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: var(--display-tracking);
    color: var(--foreground);
    text-decoration: none;
  }

  .cell-case a:hover {
    color: var(--signal);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cell-case .data {
    font-size: 0.8125rem;
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .pager-nums {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pager-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    border-radius: 0.5rem;
    color: var(--foreground);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  a.pager-num:hover {
    background: var(--muted);
  }

  .pager-num.is-current {
    background: var(--primary);
    color: var(--primary-foreground);
    font-weight: 600;
  }

  .is-off {
    opacity: 0.4;
    pointer-events: none;
  }

  @media (max-width: 680px) {
    .index-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    .index-table,
    .index-table tbody,
    .index-table tr,
    .index-table td {
      display: block;
    }

    .index-table tr {
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--border);
    }

    .index-table td {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.2rem 0;
      border: 0;
    }

    .index-table td[data-label]::before {
      content: attr(data-label);
      color: var(--muted-foreground);
    }

    .index-table td.cell-case {
      flex-direction: column;
    }

    .num {
      text-align: left;
    }
  }
</style>
