---
import BaseLayout from '../layouts/BaseLayout.astro'
import Footer from '../components/Footer.astro'
---

<BaseLayout title="Page not found | TRACED" description="This page doesn't exist in the TRACED archive." robots="noindex,follow">

  <main id="main-content" tabindex="-1">
    <div class="wrap nf band">
      <p class="nf-code figure" aria-hidden="true">404</p>
      <h1>Page not found</h1>
    </div>

    <p class="wrap nf-actions">
      <a href="/" class="btn">Search every breach</a>
      <a href="/check/" class="btn btn-ghost">Check a password</a>
    </p>

    <ol class="rows nf-blank" aria-hidden="true">
      <li class="row"></li>
      <li class="row"></li>
      <li class="row"></li>
      <li class="row"></li>
      <li class="row"></li>
      <li class="row"></li>
    </ol>
  </main>
  <Footer />
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: 1rem;
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .nf-code {
    font-size: calc(clamp(1.5rem, 4vw, 2.5rem) * var(--figure-scale));
    color: var(--ribbon);
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-block: clamp(2rem, 5vw, 3rem);
  }

  /* The list carries on, with nothing on it. */
  .nf-blank {
    border: 0;
  }

  .nf-blank .row {
    height: 2.75rem;
  }
</style>
