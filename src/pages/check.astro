---
import BaseLayout from '../layouts/BaseLayout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { PasswordChecker } from '../components/PasswordChecker'
import { getAllBreaches } from '../lib/hibp'
import { slugify } from '../lib/utils'

const allBreaches = await getAllBreaches()
const passwordBreaches = allBreaches
  .filter((b) => b.DataClasses.includes('Passwords'))
  .sort((a, b) => b.PwnCount - a.PwnCount)
  .slice(0, 8)
  .map((b) => ({
    name: slugify(b.Name),
    title: b.Title,
    pwnCount: b.PwnCount,
    breachDate: b.BreachDate,
  }))
---

<BaseLayout
  title="Password Exposure Check | TRACED Public Breach Archive"
  description="Check whether a password appears in breach data. TRACED hashes it in your browser, sends only a hash prefix, and keeps the full password on your device."
>
  <Nav currentPath="/check/" />

  <main id="main-content" tabindex="-1" class="check-page">
    <div class="wrap check-container">
      <header class="check-header">
        <h1>Check a password</h1>
        <p>
          Has your password shown up in known breach data? You can find out without sending the full password
          anywhere.
        </p>
      </header>

      <PasswordChecker passwordBreaches={passwordBreaches} client:load />

      <p class="check-source muted">
        This uses Troy Hunt's Pwned Passwords k-anonymity API.
        <a href="https://haveibeenpwned.com/Passwords" target="_blank" rel="noopener">Read how Pwned Passwords protects range searches<span class="sr-only"> (opens in a new tab)</span></a>.
      </p>

      <section class="check-explainer prose" aria-labelledby="explainer-heading">
        <h2 id="explainer-heading">What this check can and cannot tell you</h2>
        <p>
          A match means the password is in the public Pwned Passwords corpus, so stop using it. Change it anywhere it
          still protects an account, then turn on two-factor authentication on the services that matter.
        </p>
        <p>
          No match tells you less than people assume. It does not prove the password is strong or private, only that it
          has not turned up in a public dump.
        </p>
        <p>
          TRACED never ties the check to an email address, account name or browsing profile. There is nothing to sign
          into and nothing to fill out.
        </p>
        <p>
          If you reuse passwords, fix the accounts an attacker would use to reset everything else first: email,
          banking, cloud storage, school, work, shopping and social accounts. Then deal with weaker variants built on
          the same phrase or pattern.
        </p>
        <p>
          Long unique passwords beat reused memorable ones, and a password manager makes that realistic to keep up.
          This page runs one check. It does not watch your accounts and will not tell you later if something changes.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .check-page {
    min-height: 100vh;
    padding-bottom: 5rem;
  }

  .check-container {
    max-width: 52rem;
    display: grid;
    gap: 2.5rem;
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }

  .check-header {
    display: grid;
    gap: 1rem;
  }

  .check-header h1 {
    font-size: clamp(3rem, 9vw, 5.5rem);
    line-height: 0.95;
  }

  .check-header p {
    max-width: 38rem;
    font-size: 1.1875rem;
  }

  .check-source {
    max-width: 40rem;
    font-size: 0.9375rem;
  }

  .check-explainer {
    display: grid;
    gap: 0.75rem;
    max-width: 42rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .check-explainer h2 {
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
  }
</style>
