---
import BaseLayout from '../layouts/BaseLayout.astro'
import Footer from '../components/Footer.astro'
import { PasswordChecker } from '../components/PasswordChecker'
import { getAllBreaches } from '../lib/hibp'
import { slugify } from '../lib/utils'

const allBreaches = await getAllBreaches()
const passwordBreaches = allBreaches
  .filter((b) => b.DataClasses.includes('Passwords'))
  .sort((a, b) => b.PwnCount - a.PwnCount)
  .slice(0, 8)
  .map((b) => ({
    name: slugify(b.Name),
    title: b.Title,
    pwnCount: b.PwnCount,
    breachDate: b.BreachDate,
  }))
---

<BaseLayout
  currentPath="/check/"
  title="Check a Password | TRACED"
  description="Check if a password shows up in public breach data. Your browser hashes it locally and only sends a 5-character prefix."
>

  <main id="main-content" tabindex="-1" class="check-page">
    <header class="wrap check-header band">
      <h1>Check a password</h1>
    </header>

    <div class="wrap check-tool">
      <PasswordChecker passwordBreaches={passwordBreaches} client:load />
    </div>

    <hr class="divider" />

    <div class="wrap">
      <section class="check-explainer prose" aria-labelledby="explainer-heading">
        <h2 id="explainer-heading">What this check can and can't tell you</h2>
        <p>
          If your password comes back with a match, it's already sitting in the public Pwned Passwords list and you
          should stop using it. Change it on every account where it's still active, and turn on two-factor
          authentication on the accounts you actually care about.
        </p>
        <p>
          If you've been reusing that password across sites, fix the accounts someone could use to reset everything
          else first, like your email, bank, cloud storage, work, or school logins. After that, replace any close
          variations of the same phrase. A password manager is honestly the easiest way to keep a different, long
          password for every site without trying to memorize them.
        </p>
        <p>
          Getting zero matches doesn't automatically mean a password is strong or safe. It just means that exact
          password hasn't turned up in a public dump that HIBP tracks.
        </p>
        <p>
          Nothing you check here gets tied back to you because this page never asks for an email, username, or account.
          Keep in mind that it only runs a single check right now. It won't watch your accounts or notify you if a
          password leaks later.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .check-page {
    padding-bottom: 5rem;
  }

  .check-header {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .check-tool {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .check-explainer {
    padding-top: clamp(2rem, 5vw, 3rem);
  }

  .check-explainer h2 {
    margin-bottom: 0.25rem;
  }
</style>
