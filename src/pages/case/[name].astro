---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Footer from '../../components/Footer.astro'
import { getAllBreaches } from '../../lib/hibp'
import { caseRobots, caseCaveat } from '../../lib/index-policy'
import { relatedCases } from '../../lib/related-cases'
import { getDiscoveryGap, formatPwnCount, slugify } from '../../lib/utils'
import CaseSlip from '../../components/CaseSlip.astro'
import { DiscoveryGap } from '../../components/DiscoveryGap'
import { LedgerHead, LedgerRow } from '../../components/LedgerRow'
import type { HibpBreach } from '../../lib/types'

export async function getStaticPaths() {
  const breaches = await getAllBreaches()
  return breaches.map((breach) => ({
    params: { name: slugify(breach.Name) },
    props: { breach, allBreaches: breaches },
  }))
}

interface Props {
  breach: HibpBreach
  allBreaches: HibpBreach[]
}

const { breach, allBreaches } = Astro.props
const gap = getDiscoveryGap(breach)
const caveat = caseCaveat(breach)

const hasPasswords = breach.DataClasses.includes('Passwords')

const related = relatedCases(breach, allBreaches).map((b) => {
  const shared = b.DataClasses.filter((dc) => breach.DataClasses.includes(dc))
  return {
    breach: b,
    note:
      shared.length > 0
        ? `${shared.length} shared: ${shared.slice(0, 3).join(', ')}${shared.length > 3 ? ` +${shared.length - 3}` : ''}`
        : 'Close in time, nothing shared',
  }
})
const description = (breach.Description || 'No description available.')
  .replace(/<[^>]*>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim()

const caseTitle = `${breach.Title} Data Breach Case File | TRACED`
const slug = slugify(breach.Name)
const has = (...classes: string[]) => classes.some((c) => breach.DataClasses.includes(c))
const verifiedCopy = breach.IsVerified
  ? 'HIBP marks this breach as verified, which means it checked the data against the service it is attributed to.'
  : 'HIBP does not mark this breach as verified. The details come from public claims and are less certain.'
const sensitiveCopy = breach.IsSensitive
  ? 'HIBP flags it as sensitive, which limits how it can be searched on their site.'
  : 'HIBP does not flag it as sensitive.'
const passwordCopy = hasPasswords
  ? 'This breach includes passwords. If you had an account here, change that password and every place you reused it. A password manager makes unique ones easy to keep. Turn on two-factor authentication where it is offered.'
  : "The public record doesn't list passwords. The data it does list can still feed phishing and account-recovery attacks once someone combines it with other breaches."
const riskNotes = [
  has('Email addresses', 'Usernames') && 'Email addresses and usernames are what phishers and account-lookup tools start from.',
  has('Physical addresses', 'Phone numbers', 'Dates of birth', 'Names') &&
    'Names, addresses, phone numbers and birth dates make impersonation easier.',
  has('Credit cards', 'Bank account numbers', 'Social security numbers', 'Passport numbers', 'Government issued IDs') &&
    'Financial and government identifiers are the ones worth a close look at your statements and credit reports.',
].filter(Boolean) as string[]
const caseDescription = `${breach.Title} TRACED case file with ${formatPwnCount(breach.PwnCount)} exposed accounts, breach date, affected data classes, HIBP status, and source context.`

const siteUrl = 'https://traced.jonathanrreed.com'
const caseUrl = `${siteUrl}/case/${slugify(breach.Name)}/`
const caseImage = breach.LogoPath ? new URL(breach.LogoPath, siteUrl).toString() : `${siteUrl}/og-image.png`
const caseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: `${breach.Title} data breach`,
      description: caseDescription,
      datePublished: breach.AddedDate || undefined,
      dateModified: breach.ModifiedDate || breach.AddedDate || undefined,
      url: caseUrl,
      mainEntityOfPage: caseUrl,
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Jonathan R. Reed', url: 'https://jonathanrreed.com/' },
      publisher: {
        '@type': 'Organization',
        name: 'TRACED',
        url: siteUrl,
        logo: {
          '@type': 'ImageObject',
          url: `${siteUrl}/og-image.png`,
        },
      },
      image: [caseImage],
      about: { '@type': 'Thing', name: `${breach.Title} data breach` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Archive', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Case index', item: `${siteUrl}/archive/` },
        { '@type': 'ListItem', position: 3, name: breach.Title, item: caseUrl },
      ],
    },
  ],
}
---

<BaseLayout
  title={caseTitle}
  description={caseDescription}
  robots={caseRobots(breach)}
  extraSchema={caseSchema}
>

  <main id="main-content" tabindex="-1" class="case-page">
    <div class="wrap case-top band">
      <nav class="breadcrumb data" aria-label="Breadcrumb">
        <a href="/">Breaches</a>
        <span aria-hidden="true">/</span>
        <a href="/archive/">Case index</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{breach.Title}</span>
      </nav>

      <header class="case-header">
        {breach.LogoPath && (
          <img
            src={breach.LogoPath}
            alt=""
            width="56"
            height="56"
            class="case-logo"
            onerror="this.style.visibility='hidden'"
          />
        )}
        <h1 class="case-title" data-size={breach.Title.length > 26 ? 'long' : breach.Title.length > 13 ? 'medium' : 'short'} style={`view-transition-name: case-${slug}`}>{breach.Title}</h1>
      </header>
    </div>

    <div class="wrap case-grid">
      <aside class="case-slip" aria-label="Breach record" data-pinned={breach.DataClasses.length <= 10}>
        <CaseSlip breach={breach} />
      </aside>

      <div class="case-body">
        {caveat && (
          <aside class="case-caveat" role="note" aria-label="Source caveat">
            <strong>{caveat.label}</strong>
            <p>{caveat.detail}</p>
          </aside>
        )}

        <section class="case-section prose" aria-labelledby="advice-heading">
          <h2 id="advice-heading">What to do</h2>
          <p>{passwordCopy}</p>
          {riskNotes.length > 0 && <p>{riskNotes.join(' ')}</p>}
          <p class="muted">
            These counts describe the public record. They do not say whether you were in it. To find out, search your
            email address on <a href="https://haveibeenpwned.com" target="_blank" rel="noopener">Have I Been Pwned<span class="sr-only"> (opens in a new tab)</span></a>.
          </p>
        </section>

        <section class="case-section prose" aria-labelledby="report-heading">
          <h2 id="report-heading">What HIBP says happened</h2>
          <p>{description}</p>
          <p class="muted">{verifiedCopy} {sensitiveCopy}</p>
        </section>

        {gap && (
          <section class="case-section" aria-labelledby="gap-heading">
            <h2 id="gap-heading">HIBP listing interval</h2>
            <DiscoveryGap gap={gap} />
          </section>
        )}
      </div>
    </div>

    {related.length > 0 && (
      <section class="case-related" aria-labelledby="related-heading">
        <hr class="divider" />
        <div class="wrap case-related-head">
          <h2 id="related-heading">Related breaches</h2>
        </div>
        <LedgerHead lastColumn="In common" />
        <ol class="rows">
          {related.map(({ breach: b, note }) => (
            <LedgerRow breach={b} note={note} />
          ))}
        </ol>
      </section>
    )}

    <div class="wrap case-footer">
      <a href="/" class="btn">Search every breach</a>
      <a href="/archive/" class="btn btn-ghost">Browse the case index</a>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .case-page {
    padding-bottom: 4rem;
  }

  .case-top {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding-block: 1.25rem clamp(1.75rem, 4vw, 2.75rem);
  }

  .case-header {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .case-title {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .case-title[data-size='short'] {
    font-size: calc(clamp(3.25rem, 11vw, 8rem) * var(--figure-scale));
  }

  .case-title[data-size='long'] {
    font-size: calc(clamp(2rem, 5.2vw, 3.75rem) * var(--figure-scale));
  }

  /* HIBP's logos are drawn for a dark background, so they sit on a dark tile
     in both themes. */
  .case-logo {
    flex: none;
    width: clamp(3rem, 8vw, 5rem);
    height: clamp(3rem, 8vw, 5rem);
    padding: 0.5rem;
    object-fit: contain;
    background: var(--logo-tile);
    border-radius: var(--radius);
  }

  .case-grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 7vw, 5rem);
  }

  @media (min-width: 58rem) {
    .case-grid {
      grid-template-columns: 23rem minmax(0, 40rem);
    }
  }

  .case-slip {
    max-width: 26rem;
  }

  /* A short record stays beside the text as it scrolls. A long one would be
     cut off by the window, so it scrolls with the page instead. */
  @media (min-width: 58rem) and (min-height: 44rem) {
    .case-slip[data-pinned] {
      position: sticky;
      top: calc(var(--nav-h) + 1.5rem);
    }
  }

  .case-body {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .case-caveat {
    padding: 1rem 1.25rem;
    border: 1.5px solid var(--ink);
    border-left: 5px solid var(--ribbon);
    background: var(--slip);
  }

  .case-caveat p {
    margin-top: 0.25rem;
    color: var(--ink-soft);
  }

  .case-section {
    display: grid;
    gap: 0.9rem;
  }

  .case-related-head {
    display: grid;
    gap: 0.5rem;
    padding-block: clamp(2rem, 5vw, 3rem) 1.5rem;
  }

  .case-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 2.5rem;
  }
</style>
