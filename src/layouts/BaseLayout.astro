---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import Nav from '../components/Nav.astro'
// The three faces every page prints with (about 78KB together). Preloading them stops the first
// paint from waiting on the stylesheet to discover them.
import dataFont from '@fontsource-variable/martian-mono/files/martian-mono-latin-wdth-normal.woff2?url'
import bodyFont from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url'
import figureFont from '@fontsource-variable/doto/files/doto-latin-wght-normal.woff2?url'

interface Props {
  title?: string
  description?: string
  robots?: string
  imageWidth?: number
  imageHeight?: number
  /** The nav entry to light up, e.g. "/check/". */
  currentPath?: string
  /** Optional page-specific JSON-LD (e.g. a case page's Article + breadcrumb). */
  extraSchema?: unknown
}

const {
  title = 'TRACED | Data Breach Archive and Password Checker',
  description = 'Search public data breaches from Have I Been Pwned, read case files for each leak, and check passwords locally in your browser.',
  robots = 'index,follow',
  imageWidth = 1200,
  imageHeight = 630,
  extraSchema,
  currentPath,
} = Astro.props

const siteUrl = (Astro.site?.toString() ?? 'https://traced.jonathanrreed.com/').replace(/\/$/, '')
const ogImage = `${siteUrl}/og-image.png`
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString()
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TRACED',
  url: siteUrl,
  description,
  author: {
    '@type': 'Person',
    name: 'Jonathan R. Reed',
    url: 'https://jonathanrreed.com/',
    sameAs: [
      'https://github.com/JonathanRReed',
    ],
  },
  publisher: {
    '@type': 'Person',
    name: 'Jonathan R. Reed',
    url: 'https://jonathanrreed.com/',
    sameAs: [
      'https://github.com/JonathanRReed',
    ],
  },
  inLanguage: 'en-US',
  isAccessibleForFree: true,
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Jonathan R. Reed" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#262a66" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#cbe5c5" media="(prefers-color-scheme: light)" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="TRACED" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content="TRACED public data breach archive" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" href={dataFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={figureFont} crossorigin />
    <link rel="sitemap" href="/sitemap.xml" />

    <script is:inline>
      (function () {
        var root = document.documentElement
        var query = window.matchMedia('(prefers-color-scheme: dark)')
        function apply() {
          var theme = 'system'
          var font = 'default'
          try {
            theme = localStorage.getItem('colorTheme') || 'system'
            font = localStorage.getItem('traced-font') || 'default'
          } catch (e) {}
          var dark = theme === 'dark' || (theme !== 'light' && query.matches)
          root.classList.toggle('dark', dark)
          if (font === 'default') root.removeAttribute('data-font')
          else root.setAttribute('data-font', font)
        }
        window.__applyAppearance = apply
        apply()
        document.addEventListener('astro:after-swap', apply)
        query.addEventListener('change', apply)
      })()
    </script>
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {extraSchema && <script type="application/ld+json" set:html={JSON.stringify(extraSchema)} />}
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Nav currentPath={currentPath} />
    <slot />
    <div id="palette-root" transition:persist></div>
    <script>
      import '../scripts/site'
    </script>
  </body>
</html>
