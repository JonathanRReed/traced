<footer class="site-footer">
  <div class="footer-inner wrap">
    <div class="footer-brand">
      <span class="footer-wordmark">TRACED</span>
      <p>An unofficial archive of the public Have I Been Pwned breach database.</p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <a href="/archive/">Case index</a>
      <a href="/check/">Check a password</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
      <a href="https://haveibeenpwned.com" target="_blank" rel="noopener">Have I Been Pwned<span class="sr-only"> (opens in a new tab)</span></a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 2.5rem;
    background: var(--card);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 24rem;
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: 0.14em;
    line-height: 1;
  }

  .footer-brand p {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    max-width: 30rem;
  }

  .footer-links a {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    padding-block: 0.35rem;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
