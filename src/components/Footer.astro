<footer class="site-footer">
  <div class="footer-inner wrap">
    <div class="footer-brand">
      <span class="footer-wordmark figure">TRACED</span>
      <p>Unofficial. Built from Have I Been Pwned. No accounts, analytics or cookies.</p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <a href="/archive/">Case index</a>
      <a href="/check/">Check a password</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
      <a href="https://haveibeenpwned.com" target="_blank" rel="noopener">Have I Been Pwned<span class="sr-only"> (opens in a new tab)</span></a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    color: var(--foot-ink);
    background: var(--foot);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem 4rem;
    flex-wrap: wrap;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .footer-brand {
    display: grid;
    gap: 1rem;
    max-width: 26rem;
  }

  .footer-wordmark {
    font-size: calc(clamp(2.5rem, 7vw, 4rem) * var(--figure-scale));
    letter-spacing: 0.04em;
  }

  .footer-brand p {
    font-size: 0.9375rem;
    opacity: 0.8;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.1rem 2.5rem;
    font-family: var(--font-data);
    font-stretch: var(--data-stretch);
    font-size: var(--data-size);
    letter-spacing: -0.01em;
  }

  .footer-links a {
    padding-block: 0.4rem;
    color: inherit;
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .footer-links a:focus-visible {
    outline-color: var(--foot-ink);
  }
</style>
