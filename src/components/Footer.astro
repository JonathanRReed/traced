<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <span class="footer-wordmark">TRACED</span>
      <span class="footer-tagline">Public Breach Archive</span>
    </div>
    <div class="footer-right">
      <div class="footer-links">
        <a href="/about/">About</a>
        <a href="/check/">Password Check</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy/">Privacy</a>
        <a href="https://haveibeenpwned.com" target="_blank" rel="noopener">HIBP &#8599;</a>
      </div>
      <span class="footer-data">Source: <a href="https://haveibeenpwned.com" target="_blank" rel="noopener">Have I Been Pwned</a> &middot; Troy Hunt</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: 1.75rem 2rem;
    background: var(--color-surface);
  }

  .footer-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem;
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.1rem;
    letter-spacing: 0.25em;
    color: var(--color-muted);
    line-height: 1;
  }

  .footer-tagline {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    color: var(--color-muted);
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
  }

  .footer-links a {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-links a:hover { color: var(--color-text); }

  .footer-data {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-muted);
    letter-spacing: 0.05em;
  }

  .footer-data a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-data a:hover { color: var(--color-accent); }

  @media (max-width: 640px) {
    .site-footer { padding: 1.75rem 1rem; }
    .footer-inner { grid-template-columns: 1fr; gap: 1rem; }
    .footer-right { align-items: flex-start; }
  }
</style>
