---
import AppearanceMenu from './AppearanceMenu.astro'

interface Props {
  currentPath?: string
}
const { currentPath = '' } = Astro.props

const links = [
  { href: '/', label: 'Breaches' },
  { href: '/archive/', label: 'Index' },
  { href: '/check/', label: 'Check', rest: ' a password' },
  { href: '/about/', label: 'About' },
]
---

<header class="nav">
  <div class="nav-inner wrap">
    <a href="/" class="nav-wordmark figure" aria-label="TRACED home">TRACED</a>

    <nav class="nav-links" aria-label="Main">
      {links.map((link) => (
        <a href={link.href} class="nav-link" aria-current={currentPath === link.href ? 'page' : undefined}>
          {link.label}{link.rest && <span class="nav-rest">{link.rest}</span>}
        </a>
      ))}
    </nav>

    <div class="nav-tools">
      <button
        type="button"
        class="nav-tool nav-search"
        aria-label="Search breaches"
        onclick="window.dispatchEvent(new CustomEvent('open-command-palette'))"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="20" y1="20" x2="16.2" y2="16.2"/></svg>
        <kbd class="nav-kbd" data-shortcut>Ctrl K</kbd>
      </button>
      <AppearanceMenu />
    </div>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const isMac = /Mac|iPhone|iPad/.test(navigator.platform)
    document.querySelectorAll<HTMLElement>('[data-shortcut]').forEach((el) => {
      el.textContent = isMac ? '⌘K' : 'Ctrl K'
    })
  })
</script>

<style>
  /* The header is the first green bar of the page. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 300;
    background: var(--bar);
    border-bottom: 2px solid var(--ink);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: var(--nav-h);
    font-family: var(--font-data);
    font-stretch: var(--data-stretch);
    font-size: var(--data-size);
    letter-spacing: -0.01em;
  }

  .nav-wordmark {
    font-size: calc(2rem * var(--figure-scale));
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.75rem);
    margin-right: auto;
  }

  .nav-link {
    padding-block: 0.5rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }

  .nav-link:hover {
    border-bottom-color: color-mix(in srgb, var(--ink) 35%, transparent);
  }

  .nav-link[aria-current='page'] {
    border-bottom-color: var(--ink);
  }

  .nav-tools {
    display: flex;
    gap: 0.4rem;
  }

  .nav-tool,
  :global(.appearance-trigger) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding: 0 0.7rem;
    font: inherit;
    font-weight: 700;
    color: var(--ink);
    background: transparent;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .nav-tool:hover,
  :global(.appearance-trigger:hover) {
    background: var(--paper);
  }

  .nav-kbd {
    font: inherit;
    font-weight: 400;
  }

  @media (max-width: 40rem) {
    .nav-inner {
      flex-wrap: wrap;
      row-gap: 0;
      padding-block: 0.5rem 0;
    }

    .nav-wordmark {
      margin-right: auto;
    }

    .nav-tools {
      order: 2;
    }

    .nav-links {
      order: 3;
      flex: 1 0 100%;
      justify-content: space-between;
    }

    .nav-rest,
    .nav-kbd {
      display: none;
    }
  }
</style>
