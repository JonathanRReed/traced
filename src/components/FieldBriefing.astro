---
interface Props {
  breachCount: number
  criticalCount: number
}
const { breachCount, criticalCount } = Astro.props
---

<section class="briefing" aria-labelledby="briefing-heading">
  <div class="wrap briefing-inner">
    <h2 id="briefing-heading" class="section-title">How to read a case file</h2>

    <div class="briefing-grid">
      <dl class="briefing-statuses">
        <div class="status-row">
          <dt><span class="badge-status" data-status="critical">Critical</span></dt>
          <dd>
            The record includes sensitive data such as passwords, payment details, health records or government ID
            numbers. If you had an account there, change its password and anywhere you reused it.
            <span class="status-count">{criticalCount.toLocaleString('en-US')} case files.</span>
          </dd>
        </div>
        <div class="status-row">
          <dt><span class="badge-status" data-status="recent">Recent</span></dt>
          <dd>
            The breach happened within the last five years. If you had an account with the service, treat it as
            exposed and review anything tied to it.
          </dd>
        </div>
        <div class="status-row">
          <dt><span class="badge-status" data-status="older">Older</span></dt>
          <dd>
            An older breach with no sensitive data classes. It is less urgent, but it still gives context on a
            service's history.
          </dd>
        </div>
      </dl>

      <dl class="briefing-terms">
        <div>
          <dt>Case file</dt>
          <dd>
            One page per breach with its dates, the exposed data types and when HIBP added it to the database.
            {breachCount.toLocaleString('en-US')} in total.
          </dd>
        </div>
        <div>
          <dt>HIBP listing interval</dt>
          <dd>
            The time between the recorded breach date and when HIBP added it to the database. It does not tell us
            when the breach was discovered or publicly disclosed.
          </dd>
        </div>
        <div>
          <dt>Data source</dt>
          <dd>
            Everything here comes from
            <a href="https://haveibeenpwned.com" target="_blank" rel="noopener">Have I Been Pwned<span class="sr-only"> (opens in a new tab)</span></a>,
            Troy Hunt's public breach database.
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .briefing {
    border-bottom: 1px solid var(--border);
    background: var(--card);
  }

  .briefing-inner {
    padding-block: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: 2rem;
  }

  .briefing-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  dl {
    margin: 0;
  }

  dd {
    margin: 0;
  }

  .briefing-statuses {
    display: grid;
    gap: 1.25rem;
  }

  .status-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    align-items: start;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .status-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .status-row dd {
    max-width: 38rem;
  }

  .status-count {
    display: block;
    margin-top: 0.35rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }

  .briefing-terms {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .briefing-terms dt {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: var(--display-tracking);
    margin-bottom: 0.25rem;
  }

  .briefing-terms dd {
    color: var(--muted-foreground);
  }

  .briefing-terms a {
    color: var(--signal);
    text-underline-offset: 0.2em;
  }

  @media (max-width: 900px) {
    .briefing-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .status-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
